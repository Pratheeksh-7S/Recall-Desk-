# FalkorDB (local docker by default). For FalkorDB Cloud set FALKORDB_URL=redis://user:pass@host:port
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_URL=

# Pick one LLM, or leave all empty to run on offline rules.
# LLM_PROVIDER=anthropic   # anthropic | openai | gemini | offline
# LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
